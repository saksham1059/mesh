[Unit]
Description=mesh control server
After=network-online.target wg-quick@wg-mesh.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/mesh-server --config /etc/mesh/server.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mesh
ProtectHome=true

[Install]
WantedBy=multi-user.target
